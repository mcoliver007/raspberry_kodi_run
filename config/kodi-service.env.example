# Copie ce fichier en "kodi-service.env" (même dossier) et adapte les
# valeurs si besoin. "kodi-service.env" n'est volontairement pas versionné
# (voir .gitignore) pour que tes réglages locaux ne soient jamais écrasés
# par un "git pull".

# Commande de lancement de Kodi (celle utilisée manuellement jusqu'ici).
KODI_EXEC=/usr/bin/kodi

# Motif du sink PulseAudio Bluetooth à attendre.
BT_SINK_MATCH=bluez_sink

# Nom de l'unité systemd (utilisateur) du serveur TTS Piper.
PIPER_SERVICE=piper-tts.service

# Chemin du socket Unix créé par le serveur Piper.
PIPER_SOCKET=/tmp/piper_tts.sock

# Délai max (secondes) pour chaque étape d'attente.
WAIT_TIMEOUT=90
POLL_INTERVAL=2

# Phrase annoncée vocalement une fois Kodi démarré.
ANNOUNCE_TEXT=Kodi est démarré. Le son fonctionne correctement.
